import { createRouter, createWebHistory, type RouteRecordRaw } from 'vue-router'
import { useAuthStore } from '@/stores/auth'

// Vistas
const LoginView = () => import('@/views/LoginView.vue')
const DashboardView = () => import('@/views/DashboardView.vue')
const ServersView = () => import('@/views/ServersView.vue')
const ServerDetail = () => import('@/views/ServerDetail.vue')
const MonitoringPerformance = () => import('@/views/MonitoringPerformance.vue')
const MonitoringAlerts = () => import('@/views/MonitoringAlerts.vue')
const MonitoringMetrics = () => import('@/views/MonitoringMetrics.vue')
const SettingsUsers = () => import('@/views/SettingsUsers.vue')
const SettingsRoles = () => import('@/views/SettingsRoles.vue')
const SettingsPreferences = () => import('@/views/SettingsPreferences.vue')
const NotFoundView = () => import('@/views/NotFoundView.vue')

const routes: Array<RouteRecordRaw> = [
  {
    path: '/login',
    name: 'login',
    component: LoginView,
    meta: { requiresAuth: false }
  },
  {
    path: '/',
    name: 'dashboard',
    component: DashboardView,
    meta: { 
      requiresAuth: true, 
      title: 'Dashboard',
      icon: 'mdi-view-dashboard'
    }
  },
  {
    path: '/dashboard',
    redirect: '/'
  },
  {
    path: '/servers',
    name: 'servers',
    component: ServersView,
    meta: { 
      requiresAuth: true, 
      title: 'Servidores',
      icon: 'mdi-server'
    }
  },
  {
    path: '/servers/:id',
    name: 'server-detail',
    component: ServerDetail,
    meta: { 
      requiresAuth: true, 
      title: 'Detalle del Servidor',
      showInMenu: false
    },
    props: true
  },
  {
    path: '/monitoring/performance',
    name: 'monitoring-performance',
    component: MonitoringPerformance,
    meta: { 
      requiresAuth: true, 
      title: 'Rendimiento',
      parent: 'monitoring',
      icon: 'mdi-chart-line'
    }
  },
  {
    path: '/monitoring/alerts',
    name: 'monitoring-alerts',
    component: MonitoringAlerts,
    meta: { 
      requiresAuth: true, 
      title: 'Alertas',
      parent: 'monitoring',
      icon: 'mdi-alert'
    }
  },
  {
    path: '/monitoring/metrics',
    name: 'monitoring-metrics',
    component: MonitoringMetrics,
    meta: { 
      requiresAuth: true, 
      title: 'Métricas',
      parent: 'monitoring',
      icon: 'mdi-chart-areaspline'
    }
  },
  {
    path: '/settings/users',
    name: 'settings-users',
    component: SettingsUsers,
    meta: { 
      requiresAuth: true, 
      title: 'Usuarios',
      parent: 'settings',
      icon: 'mdi-account-group'
    }
  },
  {
    path: '/settings/roles',
    name: 'settings-roles',
    component: SettingsRoles,
    meta: { 
      requiresAuth: true, 
      title: 'Roles',
      parent: 'settings',
      icon: 'mdi-shield-account'
    }
  },
  {
    path: '/settings/preferences',
    name: 'settings-preferences',
    component: SettingsPreferences,
    meta: { 
      requiresAuth: true, 
      title: 'Preferencias',
      parent: 'settings',
      icon: 'mdi-cog'
    }
  },
  {
    path: '/:pathMatch(.*)*',
    name: 'not-found',
    component: NotFoundView,
    meta: { requiresAuth: false }
  }
]

const router = createRouter({
  history: createWebHistory(import.meta.env.BASE_URL),
  routes,
  scrollBehavior(to, from, savedPosition) {
    return savedPosition || { top: 0 }
  }
})

// Guard de navegación
router.beforeEach(async (to, from, next) => {
  const authStore = useAuthStore()
  
  // Establecer título de la página
  const title = to.meta.title ? \\ | CogniTrack2\ : 'CogniTrack2'
  document.title = title

  // Verificar si la ruta requiere autenticación
  if (to.meta.requiresAuth && !authStore.isAuthenticated) {
    return next({ 
      name: 'login', 
      query: { redirect: to.fullPath } 
    })
  }

  next()
}) 
    })
  }

  next()
})

export default router




