# =============================================================================
# CogniTrack .dockerignore - Optimizado
# =============================================================================

# Excluir archivos innecesarios para reducir el contexto de construcción

# Frontend files (no necesarios para el backend)
frontend/
scripts/
docs/
nginx/
*.md
!README.md

# Archivos de desarrollo y temporales
.vscode/
.idea/
*.log
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# Git y control de versiones
.git/
.gitignore
.gitattributes

# Node.js (no necesario para backend Go)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Archivos de entorno (se crean en tiempo de ejecución)
.env*
!.env.example

# Archivos de respaldo y zips
*.zip
backup/
*.tar.gz

# Archivos de prueba y desarrollo
test/
tests/
*_test.go
*.test.js
*.spec.js

# Archivos de construcción frontend
dist/
build/
coverage/

# Archivos de Docker innecesarios
Dockerfile.*
docker-compose*.yml
.dockerignore

# Archivos de configuración del sistema
*.conf
nginx*.conf

# Archivos de logs y salida
logs/
*.out

# Archivos de Python (virtual environments)
venv/
__pycache__/
*.pyc

# Archivos de Windows
Thumbs.db
Desktop.ini

# Archivos de macOS
.DS_Store
.AppleDouble
.LSOverride

# Archivos de editor
*.sublime-project
*.sublime-workspace

# Archivos de configuración de herramientas
.eslintrc*
.prettierrc*
babel.config.js
jest.config.js
webpack.config.js

# Solo incluir archivos necesarios para el backend
!backend/
!Dockerfile
!README.md