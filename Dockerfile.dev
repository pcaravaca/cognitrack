# =============================================================================
# CogniTrack Backend Dockerfile - Desarrollo
# =============================================================================

FROM golang:1.21-alpine AS development

# Metadata
LABEL maintainer="CogniTrack Team" \
      description="CogniTrack Backend Development Environment" \
      stage=development

# Configurar el directorio de trabajo
WORKDIR /app

# Instalar herramientas de desarrollo
RUN apk add --no-cache \
    gcc \
    musl-dev \
    git \
    make \
    curl \
    wget \
    vim \
    && rm -rf /var/cache/apk/*

# Crear usuario desarrollador
RUN addgroup -g 1000 dev && \
    adduser -D -s /bin/ash -u 1000 -G dev dev

# Configurar Go environment para desarrollo
ENV GO111MODULE=on \
    CGO_ENABLED=1 \
    GOOS=linux \
    GOARCH=amd64

# Instalar air para hot reload (opcional)
RUN go install github.com/cosmtrek/air@latest

# Cambiar propietario del directorio de trabajo
RUN chown -R dev:dev /app /go

# Cambiar al usuario desarrollador
USER dev

# Puerto expuesto
EXPOSE 8081 2345

# Comando por defecto para desarrollo
CMD ["go", "run", "."]
