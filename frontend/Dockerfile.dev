# Usar una imagen de Node.js con la versión 18
FROM node:18-alpine

# Establecer el directorio de trabajo
WORKDIR /app

# Instalar dependencias del sistema necesarias
RUN apk add --no-cache git python3 make g++ xdg-utils

# Crear un script falso para xdg-open que no haga nada
RUN echo '#!/bin/sh' > /usr/bin/xdg-open && \
    echo 'exit 0' >> /usr/bin/xdg-open && \
    chmod +x /usr/bin/xdg-open

# Instalar pnpm globalmente usando corepack (método recomendado)
RUN corepack enable && corepack prepare pnpm@8.9.0 --activate

# Copiar solo los archivos necesarios para instalar dependencias
COPY package.json pnpm-lock.yaml* ./

# Instalar dependencias con más verbosidad y manejo de errores
RUN pnpm install --frozen-lockfile --reporter=append-only || \
    (echo "Falló la instalación con --frozen-lockfile, intentando sin él..." && pnpm install)

# Copiar archivos de la aplicación
COPY . .

# Dar permisos de ejecución al script de inicio
RUN chmod +x docker-run.sh

# Exponer el puerto de la aplicación
EXPOSE 5173

# Establecer las variables de entorno para desarrollo
ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=5173
# Deshabilitar la apertura automática del navegador
ENV BROWSER=none

# Crear un script falso para xdg-open que no haga nada
RUN echo '#!/bin/sh' > /usr/local/bin/xdg-open && \
    echo 'exit 0' >> /usr/local/bin/xdg-open && \
    chmod +x /usr/local/bin/xdg-open

# Hacer ejecutables los scripts de inicio
RUN chmod +x /app/docker-run.sh /app/fake-xdg-open.sh

# Establecer el PATH para priorizar nuestro directorio de scripts
ENV PATH="/app:${PATH}"

# Comando para iniciar la aplicación usando el script de inicio directo
CMD ["/app/docker-run.sh"]
