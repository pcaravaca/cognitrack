<template>
  <v-navigation-drawer
    v-model="drawer"
    :rail="isMiniVariant"
    :permanent="!isMobile"
    :temporary="isMobile"
    app
    class="sidebar"
    @mouseenter="onMouseEnter"
    @mouseleave="onMouseLeave"
  >
    <!-- Encabezado del menú -->
    <div class="sidebar-header" v-if="!isMiniVariant">
      <v-list-item
        :title="appName"
        :subtitle="appDescription"
        :class="{ 'px-4': !isMiniVariant }"
      >
        <template v-slot:prepend>
          <v-avatar color="primary" size="40" class="mr-2">
            <v-icon icon="mdi-server-network" />
          </v-avatar>
        </template>
      </v-list-item>
    </div>
    <v-divider />

    <!-- Menú de navegación -->
    <v-list density="compact" nav>
      <template v-for="(item, i) in menuItems" :key="i">
        <!-- Grupo de menú con subelementos -->
        <v-list-group v-if="item.children" :value="isActiveGroup(item)">
          <template v-slot:activator="{ props }">
            <v-list-item
              v-bind="props"
              :prepend-icon="item.icon"
              :title="item.title"
              :value="item.title"
              :class="{ 'active-menu-item': isActive(item) }"
            />
          </template>

          <v-list-item
            v-for="(child, j) in item.children"
            :key="j"
            :to="child.to"
            :prepend-icon="child.icon || 'mdi-circle-small'"
            :title="child.title"
            :value="child.title"
            :class="{ 'active-menu-item': isActive(child) }"
            class="ml-4"
          />
        </v-list-group>

        <!-- Elemento de menú simple -->
        <v-list-item
          v-else
          :to="item.to"
          :prepend-icon="item.icon"
          :title="item.title"
          :value="item.title"
          :class="{ 'active-menu-item': isActive(item) }"
        />
      </template>
    </v-list>

    <!-- Pie del menú -->
    <template v-slot:append>
      <v-divider />
      <div class="pa-2">
        <v-btn
          variant="text"
          block
          :icon="isMiniVariant ? 'mdi-chevron-right' : 'mdi-chevron-left'"
          @click="toggleMiniVariant"
          class="toggle-sidebar"
          :title="isMiniVariant ? 'Expandir menú' : 'Contraer menú'"
        />
      </div>
    </template>
  </v-navigation-drawer>
</template>

<script setup lang="ts">
import { ref, computed, watch, onMounted, onBeforeUnmount } from 'vue'
import { useRoute } from 'vue-router'
import { useDisplay } from 'vuetify'

// Props y eventos
const props = defineProps({
  modelValue: {
    type: Boolean,
    default: true
  }
})

const emit = defineEmits(['update:modelValue', 'toggle'])

// Utilidades
const route = useRoute()
const { mobile } = useDisplay()

// Estado del menú
const drawer = ref(true)
const isMiniVariant = ref(false)
const isHovering = ref(false)

// Datos de la aplicación
const appName = 'CogniTrack2'
const appDescription = 'Monitor de servidores'

// Elementos del menú
const menuItems = [
  {
    title: 'Dashboard',
    icon: 'mdi-view-dashboard',
    to: '/',
    exact: true
  },
  {
    title: 'Servidores',
    icon: 'mdi-server',
    to: '/servers'
  },
  {
    title: 'Monitorización',
    icon: 'mdi-monitor-dashboard',
    children: [
      { title: 'Rendimiento', to: '/monitoring/performance' },
      { title: 'Alertas', to: '/monitoring/alerts' },
      { title: 'Métricas', to: '/monitoring/metrics' }
    ]
  },
  {
    title: 'Configuración',
    icon: 'mdi-cog',
    children: [
      { title: 'Usuarios', to: '/settings/users' },
      { title: 'Roles', to: '/settings/roles' },
      { title: 'Preferencias', to: '/settings/preferences' }
    ]
  }
]

// Computed
const isMobile = computed(() => mobile.value)

// Métodos
const toggleMiniVariant = () => {
  isMiniVariant.value = !isMiniVariant.value
}

const onMouseEnter = () => {
  if (isMiniVariant.value) {
    isHovering.value = true
  }
}

const onMouseLeave = () => {
  if (isMiniVariant.value) {
    isHovering.value = false
  }
}

const isActive = (item: any) => {
  if (item.exact) {
    return route.path === item.to
  }
  return route.path.startsWith(item.to)
}

const isActiveGroup = (item: any) => {
  return item.children?.some((child: any) => isActive(child))
}

// Watchers y lifecycle hooks
watch(() => props.modelValue, (val) => {
  drawer.value = val
})

watch(drawer, (val) => {
  emit('update:modelValue', val)
})

// Ajustar el menú según el tamaño de la pantalla
const handleResize = () => {
  if (window.innerWidth < 960) {
    isMiniVariant.value = false
  }
}

// Inicialización
onMounted(() => {
  window.addEventListener('resize', handleResize)
  handleResize()
})

onBeforeUnmount(() => {
  window.removeEventListener('resize', handleResize)
})
</script>

<style scoped>
/* Estilos del menú lateral */
.sidebar {
  transition: all 0.3s ease;
  box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
  z-index: 10;
}

/* Encabezado del menú */
.sidebar-header {
  padding: 16px;
  background: linear-gradient(45deg, var(--v-primary-base), var(--v-primary-darken-2));
  color: white;
}

/* Elementos del menú activos */
.active-menu-item {
  background-color: rgba(var(--v-primary-base), 0.1);
  border-left: 3px solid var(--v-primary-base);
  color: var(--v-primary-base);
}

/* Botón para contraer/expandir */
.toggle-sidebar {
  transition: all 0.3s ease;
}

.toggle-sidebar:hover {
  transform: scale(1.1);
}

/* Ajustes para móviles */
@media (max-width: 959px) {
  .v-navigation-drawer {
    width: 280px !important;
  }
}

/* Mejoras de accesibilidad */
:deep(.v-list-item--active) {
  font-weight: 500;
}

:deep(.v-list-group__items .v-list-item) {
  padding-left: 32px !important;
}

/* Efecto hover para elementos del menú */
:deep(.v-list-item--link:not(.v-list-item--active):hover) {
  background-color: rgba(0, 0, 0, 0.04);
}
</style>
