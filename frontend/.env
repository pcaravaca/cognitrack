# Configuración del entorno de desarrollo

# URL base del backend (sin / al final)
VITE_BACKEND_URL=http://localhost:9080

# URL base de la API de Ollama (sin / al final)
# Esta variable es usada por el proxy de Vite y las conexiones de la aplicación
VITE_OLLAMA_SERVER_URL=http://192.168.0.104:11434

# IMPORTANTE: No hardcodear IPs en la aplicación
# Usar siempre los servidores configurados por el usuario

# Nivel de depuraciu00f3n (opcional, valores: true/false)
DEBUG=true

# Puerto del servidor de desarrollo (opcional, por defecto: 5173)
PORT=5173

# Host del servidor de desarrollo (opcional, por defecto: 0.0.0.0)
HOST=0.0.0.0

# Configuraciu00f3n de WebSocket (opcional)
VITE_WS_URL=ws://192.168.0.104:11434/ws
