import { defineConfig, loadEnv } from 'vite';
import vue from '@vitejs/plugin-vue';
import { fileURLToPath, URL } from 'node:url';
import vuetify from 'vite-plugin-vuetify';

export default defineConfig(({ mode }) => {
  // Cargar variables de entorno
  const env = loadEnv(mode, process.cwd(), '');
  
  // Configuración base
  const config = {
    base: '/',
    plugins: [
      vue(),
      vuetify({ autoImport: true }),
    ],
    resolve: {
      alias: {
        '@': fileURLToPath(new URL('./src', import.meta.url)),
      },
    },
    css: {
      preprocessorOptions: {
        scss: {
          additionalData: `
            @use "sass:map";
            @use "sass:math";
            @import "@/assets/styles/settings";
          `,
        },
      },
    },
    build: {
      outDir: 'dist',
      assetsDir: 'assets',
      emptyOutDir: true,
      sourcemap: env.NODE_ENV !== 'production',
      minify: env.NODE_ENV === 'production' ? 'terser' : false,
      terserOptions: {
        compress: {
          drop_console: env.NODE_ENV === 'production',
          drop_debugger: env.NODE_ENV === 'production',
        },
      },
      rollupOptions: {
        output: {
          manualChunks: {
            vue: ['vue', 'vue-router', 'pinia'],
            vuetify: ['vuetify', 'vuetify/components', 'vuetify/directives'],
          },
        },
      },
    },
    optimizeDeps: {
      include: ['vue', 'vue-router', 'pinia', 'vuetify'],
      exclude: ['@mdi/font']
    }
  };

  // Configuración de desarrollo
  if (env.NODE_ENV !== 'production') {
    config.server = {
      port: 5173,
      host: '0.0.0.0',
      strictPort: true,
      open: false,
      cors: true,
      proxy: {
        '/api': {
          target: 'http://localhost:8080',
          changeOrigin: true,
          secure: false,
          ws: true,
          rewrite: (path) => path.replace(/^\/api/, '')
        },
        '/api/ws': {
          target: 'ws://localhost:8080',
          changeOrigin: true,
          secure: false,
          ws: true,
          rewrite: (path) => path.replace(/^\/api\/ws/, '')
        }
      }
    };

    config.preview = {
      port: 5174,
      strictPort: true,
      host: '0.0.0.0',
      open: false,
      cors: true
    };
  }

  return config;
});
